# Google Gemini API Key
# Get a key at: https://aistudio.google.com/ (image generation requires billing; no free tier)
GEMINI_API_KEY=your-api-key-here

# Optional: Default image size (512, 1K, 2K or 4K)
# Optional: Model ID (default gemini-3.1-flash-image)
# GEMINI_MODEL=gemini-3.1-flash-image
# IMAGE_SIZE=1K
